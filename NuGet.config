<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- use a local package folder so all packages this project needs are cached locally
    and it's much easier to clean a local repository than the global nuget cache -->
    <add key="repositorypath" value=".packages" />
    <add key="globalPackagesFolder" value=".packages" />
  </config>
 <packageSources>
    <add key="Local godot build" value="d:\code\godot\upstream\godot\bin\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>